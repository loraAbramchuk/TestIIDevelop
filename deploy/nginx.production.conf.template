# Docker changes app's IP on recreation; resolve it without restarting Nginx.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 2s;
upstream video_api {
    zone video_api 64k;
    server app:8000 resolve;
}

# Log the original public path, without query or X-Accel storage keys.
map $request_uri $video_request_path {
    ~^([^?]*) $1;
    default "";
}

log_format video_ops escape=json '{"time":"$time_iso8601","method":"$request_method","uri":"$video_request_path","status":$status,"bytes":$body_bytes_sent,"duration":$request_time}';
# HTTP failures are counted in the structured log; omit request-bearing upstream errors.
error_log /var/log/nginx/error.log crit;

map "${PUBLIC_HTTPS_PORT}" $video_https_suffix {
    "443" "";
    default ":${PUBLIC_HTTPS_PORT}";
}

server {
    listen 80;
    access_log /var/log/nginx/access.log video_ops;
    server_name ${SITE_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://${SITE_DOMAIN}$video_https_suffix$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${SITE_DOMAIN};
    if ($host != "${SITE_DOMAIN}") { return 421; }
    ssl_certificate /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:video_tls:10m;
    ssl_session_tickets off;
    include /etc/nginx/conf.d/includes/video-locations.conf;
}
# Internal Docker health probe; this port is never published.
server {
    listen 8081;
    access_log off;
    server_name _;
    location = /health/ready { proxy_pass http://video_api; }
    location / { return 404; }
}
