# Use `python3 scripts/init_env.py` to generate .env with a random password.
# This example is documentation only; do not use a shared/default password.
POSTGRES_PASSWORD=
POSTGRES_USER=video
POSTGRES_DB=video
DB_HOST=localhost
DB_PORT=5432
HTTP_PORT=8080
MEDIA_ROOT=.local/media
# Set true when serving through HTTPS. Development over HTTP uses false.
AUTH_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=336

# Upload and processing policy (local POSIX storage, one server).
MAX_UPLOAD_BYTES=1073741824
OWNER_MEDIA_QUOTA_BYTES=10737418240
MEDIA_CAPACITY_BYTES=107374182400
MEDIA_MIN_FREE_BYTES=2147483648
PREVIEW_BUDGET_BYTES=16777216
MAX_UPLOADS_PER_OWNER=2
MAX_UPLOADS_TOTAL=4
MAX_PENDING_VIDEO_JOBS=100
UPLOAD_IDLE_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=3600
UPLOAD_LEASE_SECONDS=120
UPLOAD_HEARTBEAT_SECONDS=15
PROCESSING_CONCURRENCY=1
FFPROBE_TIMEOUT_SECONDS=30
PROCESSING_TIMEOUT_SECONDS=900
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_LONG_SIDE=1920
MAX_VIDEO_SHORT_SIDE=1080
MAX_VIDEO_FPS=60
VIDEO_CREATE_LIMIT_PER_HOUR=30
VIDEO_WRITE_LIMIT_PER_MINUTE=120
INTERACTION_WRITE_LIMIT_PER_MINUTE=120
COMMENT_CREATE_LIMIT_PER_MINUTE=10
PLAYLIST_WRITE_LIMIT_PER_MINUTE=120
PLAYLIST_CREATE_LIMIT_PER_HOUR=30
PLAYLIST_MAX_ITEMS=1000
REPORT_CREATE_LIMIT_PER_HOUR=10
MODERATION_WRITE_LIMIT_PER_MINUTE=120
ADMIN_WRITE_LIMIT_PER_MINUTE=30
UPLOAD_LIMIT_PER_HOUR=30
UPLOAD_CLEANUP_INTERVAL_SECONDS=15
PROCESSING_LEASE_SECONDS=60
PROCESSING_HEARTBEAT_SECONDS=5
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_SECONDS=15
# Virtual address space per FFmpeg/ffprobe child; container RSS cap includes the worker.
PROCESSING_MEMORY_BYTES=805306368
PROCESSING_CONTAINER_MEMORY=2g
PROCESSING_CPUS=1.0

# Public deployment: scripts/install.sh --domain DOMAIN --email EMAIL.
# The production overlay forces Secure cookies and exposes HTTP 80 / HTTPS 443.
# SITE_DOMAIN=video.example.com
# ACME_EMAIL=ops@example.com
# HTTP_PUBLIC_PORT=80
# HTTPS_PORT=443
# PUBLIC_BIND_ADDRESS=0.0.0.0
# TLS_ROOT=/opt/video-platform/.local/operations/video-platform/letsencrypt
# ACME_WEBROOT=/opt/video-platform/.local/operations/video-platform/acme
# Encrypted off-site backups. Keep the PRIVATE age identity on a separate machine.
# BACKUP_RECIPIENT=age1_REPLACE_WITH_REAL_RECIPIENT
# BACKUP_SSH_TARGET=backup@backup.example.com
# BACKUP_SSH_PATH=/srv/backups/video-platform
# BACKUP_SSH_IDENTITY=/root/.ssh/video-backup
# BACKUP_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
# BACKUP_SSH_PORT=22
# BACKUP_MIN_FREE_BYTES=2147483648
# Effective reserve is max(BACKUP_MIN_FREE_BYTES, MEDIA_MIN_FREE_BYTES).
# BACKUP_KEEP_LOCAL=7
# BACKUP_DIR=/opt/video-platform/.local/operations/video-platform/backups
