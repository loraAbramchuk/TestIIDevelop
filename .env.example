# Use `python3 scripts/init_env.py` to generate .env with a random password.
# This example is documentation only; do not use a shared/default password.
POSTGRES_PASSWORD=
POSTGRES_USER=video
POSTGRES_DB=video
DB_HOST=localhost
DB_PORT=5432
HTTP_PORT=8080
MEDIA_ROOT=.local/media
# Set true when serving through HTTPS. Development over HTTP uses false.
AUTH_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=336

# Stage 1 policy; video upload and processing endpoints are not implemented yet.
MAX_UPLOAD_BYTES=1073741824
OWNER_MEDIA_QUOTA_BYTES=10737418240
MEDIA_CAPACITY_BYTES=107374182400
MEDIA_MIN_FREE_BYTES=2147483648
PREVIEW_BUDGET_BYTES=16777216
MAX_UPLOADS_PER_OWNER=2
MAX_UPLOADS_TOTAL=4
MAX_PENDING_VIDEO_JOBS=100
UPLOAD_IDLE_TIMEOUT_SECONDS=60
UPLOAD_TIMEOUT_SECONDS=3600
UPLOAD_LEASE_SECONDS=120
UPLOAD_HEARTBEAT_SECONDS=15
PROCESSING_CONCURRENCY=1
FFPROBE_TIMEOUT_SECONDS=30
PROCESSING_TIMEOUT_SECONDS=900
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_LONG_SIDE=1920
MAX_VIDEO_SHORT_SIDE=1080
MAX_VIDEO_FPS=60
